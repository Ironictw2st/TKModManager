{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TK Mod Manager",
  "version": "0.1.0",
  "identifier": "com.ironictw2st.tkmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TK Mod Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["**/*.png", "**/*.jpg"] },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
