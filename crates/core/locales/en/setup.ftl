# First-time setup: shown on the manager's first start on a PC, and from the ? button.

setup-title = Set up TK Mod Manager
setup-skip = Skip setup

setup-welcome-title = Welcome
setup-welcome-text = TK Mod Manager starts Three Kingdoms with the mods you choose, keeps them in the right order and helps when something goes wrong. This takes a minute.
# $store = Steam / Epic / Game Pass, $version = game version, $path = game folder
setup-game-found = Found your game: { $store }, version { $version }, in { $path }.
setup-game-missing = Three Kingdoms was not found. Choose its folder below.
setup-game-change = Choose the game folder…
setup-game-change-tip = Only needed if the manager found the wrong copy, or none

setup-mods-title = Your mods
setup-mods-text = Every mod you are subscribed to on the Workshop is already listed, ticked the way CA's launcher had it. To start from another list instead:
setup-mods-hint = You can do this later too, from Settings > Playing together.

setup-se-title = Script extender
setup-se-text = Many mods, 190 Expanded among them, need the script extender. It adds engine fixes, better AI and new tools for mods, and the manager loads it for you when you press Play.
setup-se-installed = Installed: v{ $version }.
setup-se-not-installed = Not installed yet.
setup-se-install = Install or update it
setup-se-install-tip = Looks for the newest version and asks before downloading anything

setup-updates-title = Updates
setup-updates-text = What the manager may check for when it starts. It always asks before installing anything.

setup-done-title = All set
setup-done-text = Tick the mods you want and press Play. A one-minute tour shows where everything is.
setup-take-tour = Take the tour
setup-start = Start using the manager
