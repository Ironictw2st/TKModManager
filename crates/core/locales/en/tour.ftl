# The guided tour: a card next to each part of the window.

# $step of $total, e.g. "2 of 7"
tour-count = { $step } of { $total }
tour-back = Back
tour-next = Next
tour-done = Done
tour-end = End tour

tour-mods-title = Your mods
tour-mods-text = Tick the mods you want to play with. Drag them to change the load order: when two mods change the same thing, the one lower down wins.
tour-profile-title = Profiles
tour-profile-text = A profile is a saved mod list. Make one per campaign, or one for playing with a friend. Actions has new, copy, rename and more.
tour-play-title = Play
tour-play-text = Starts the game with this profile. The manager writes the mod list and loads the script extender for you.
tour-dlls-title = DLLs
tour-dlls-text = Extras the game loads besides mods: the script extender and Three Kingdoms Coop. Install them and switch their features on or off here.
tour-conflicts-title = Conflicts
tour-conflicts-text = Shows which mods change the same files, and which one the game uses. Pairs marked "check" are worth a look.
tour-trouble-title = Troubleshooting
tour-trouble-text = If the game crashes, come here and press Send report. It sends everything the developers need.
tour-settings-title = Settings
tour-settings-text = Folders, updates, Nexus Mods and sharing your mod list with friends. The ? button next to it runs this tour again.
